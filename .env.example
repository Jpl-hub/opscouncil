# Core runtime
APP_ENV=production
DATABASE_URL=postgresql+psycopg://opscouncil:REPLACE_WITH_STRONG_PASSWORD@127.0.0.1:5432/opscouncil
EMBEDDING_DIM=1024

# Model gateway
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_CHAT_MODEL=qwen-plus-latest
BAILIAN_EMBEDDING_MODEL=text-embedding-v4
BAILIAN_RERANK_MODEL=qwen3-rerank
BAILIAN_RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1

# Investigation limits
OPSCOUNCIL_INVESTIGATION_MAX_ITERATIONS=4
OPSCOUNCIL_INVESTIGATION_MAX_TOOL_CALLS=12
OPSCOUNCIL_INVESTIGATION_MAX_ELAPSED_MS=120000
OPSCOUNCIL_LAB_EVALUATION_TASK_TIMEOUT_SECONDS=420

# Worker and patrol runtime
OPSCOUNCIL_PATROL_ENABLED=true
OPSCOUNCIL_PATROL_SEED_DEFAULT_POLICY=true
OPSCOUNCIL_PATROL_INTERVAL_SECONDS=300
OPSCOUNCIL_WORKER_HEARTBEAT_SECONDS=5
OPSCOUNCIL_WORKER_STALE_SECONDS=20
OPSCOUNCIL_WORKER_QUEUE_WARN_SECONDS=60

# Restricted execution boundary
OPSCOUNCIL_EXECUTOR_MODE=restricted-local
OPSCOUNCIL_EXECUTOR_USER=opscouncil-agent
OPSCOUNCIL_ALLOW_ROOT_EXECUTOR=false
OPSCOUNCIL_RESTARTABLE_UNITS=
OPSCOUNCIL_REPAIRABLE_CONFIG_PATHS=

# Feishu channel. Credentials belong in /etc/opscouncil/feishu.env.
OPSCOUNCIL_FEISHU_ENABLED=false
OPSCOUNCIL_FEISHU_DEFAULT_CHAT_ID=
OPSCOUNCIL_CHANNEL_INTERNAL_TOKEN=

# Optional AgentTeams control plane
AGENTTEAMS_MATRIX_URL=
AGENTTEAMS_USERNAME=
AGENTTEAMS_PASSWORD=
AGENTTEAMS_TEAM_ROOM_ID=
AGENTTEAMS_LEADER_USER_ID=
AGENTTEAMS_CALLBACK_SECRET=

# Deterministic policy controller. Only exact deployed policy references can
# authorize reversible automatic execution; an empty list keeps every change
# human-gated.
OPSCOUNCIL_AUTO_POLICY_REFS=
OPSCOUNCIL_POLICY_CONTROLLER_IDLE_SECONDS=0.5
OPSCOUNCIL_POLICY_CONTROLLER_LEASE_SECONDS=300
